# Secrets — never commit. Contains live Gemini API keys.
.env

# OS junk
.DS_Store

# Python
__pycache__/
*.pyc

# Independent train runtime state (not the shared test state).
train/runs/
train/archive/pilot/runs/

# New test generation/review state. It contains blinded reviewer work and private sealed qrels.
test/runs/

# Provider response cache lives inside the ignored private run state.
test/runs/*/cache/

# Tokenizer probe: per-family predictions/logs and local virtualenvs stay local.
experiments/tokenizer_probe/runs/
experiments/tokenizer_probe/.venv*/
experiments/tokenizer_probe/.vendor/
experiments/tokenizer_probe/artifacts/
debugging_logs.txt
